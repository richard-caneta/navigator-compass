{
  "manifest_version": 3,
  "name": "Compass",
  "version": "1.1.0",
  "description": "Sidebar access to CN classification, Exception overrides, and the Rulebook.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Compass",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}